# ==============================================================================
# AlphaTrade AI v2.0 — Production Cloud Deployment Environment Template
# ==============================================================================
# Rename or copy this file to `.env` on your cloud server (e.g., AWS EC2 / GCP).
# NEVER commit the actual `.env` file containing secrets to version control.

# --- 1. Service & Networking ---
PORT=8080
TZ=Asia/Kolkata

# --- 2. Multi-Tenant Security & Cryptographic Vault ---
# 32+ character random secret used for encrypting broker API keys at rest in the DB
ALPHATRADE_SECRET_KEY=generate_a_random_32_char_secret_key_here
# Secret key for signing multi-tenant JWT bearer tokens
ALPHATRADE_JWT_SECRET=generate_a_random_jwt_secret_token_here

# --- 3. Execution & Safety Controls ---
# Modes: 'PAPER' (safe testing sandbox) or 'LIVE' (real capital execution)
ALPHATRADE_EXECUTION_MODE=PAPER
# Required only if ALPHATRADE_EXECUTION_MODE='LIVE'
ALPHATRADE_LIVE_CONFIRMATION=I_ACCEPT_FINANCIAL_RISK
# Live order quantity safety ceiling (per individual order)
ALPHATRADE_LIVE_MAX_QUANTITY=100

# Strategy Capital Profile: 'ASYMMETRIC_25PCT_MOMENTUM', 'NANO_5K', 'STANDARD_100K'
ALPHATRADE_CAPITAL_PROFILE=ASYMMETRIC_25PCT_MOMENTUM
# F&O Policy: 'false' for live real trading, 'true' for hybrid paper F&O sandbox
ALPHATRADE_FNO_PAPER_ONLY=false
# Autonomous background tick scheduler
ALPHATRADE_ENABLE_INTRADAY_POLLER=true

# --- 4. Database & Caching ---
# Default SQLite local database path inside container volume
DATABASE_URL=sqlite:////app/data/alphatrade_v2.db
# Or use PostgreSQL for multi-tenant cloud RDS:
# DATABASE_URL=postgresql://alphatrade:alphatrade_secure_pass_2026@postgres:5432/alphatrade

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# --- 5. Optional Default Angel One SmartAPI Credentials ---
# Note: In multi-tenant cloud mode, each user configures their own credentials via UI
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_TOTP_SECRET=
ANGEL_PASSWORD=
ANGEL_CLIENT_PUBLIC_IP=
