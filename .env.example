# AlphaTrade AI v2.0 Environment Configuration
# CRITICAL SAFETY: EXECUTION_MODE must ALWAYS be 'PAPER'. Any 'LIVE' setting fails closed at startup.
ALPHATRADE_EXECUTION_MODE=PAPER
ALPHATRADE_DATABASE_URL=sqlite:///./alphatrade_v2.db
ALPHATRADE_CAPITAL_PROFILE=STANDARD_RESEARCH_100K

# Pre-Cleared M0 Broker Data Provider (Choose: FYERS_V3 | UPSTOX_V3 | ANGEL_SMARTAPI | LOCAL_CSV)
ALPHATRADE_DATA_PROVIDER=FYERS_V3
FYERS_APP_ID=your_fyers_client_id_here
FYERS_ACCESS_TOKEN=your_fyers_access_token_here

UPSTOX_API_KEY=your_upstox_key_here
UPSTOX_ACCESS_TOKEN=your_upstox_token_here

ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_TOTP_SECRET=your_totp_secret_here
ANGEL_PASSWORD=your_trading_mpin_here

# Event Notifications (Optional Discord & Telegram Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here